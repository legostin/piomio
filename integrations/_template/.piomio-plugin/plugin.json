{
  "id": "sun",
  "name": "%name%",
  "version": "0.1.0",
  "author": "Piomio",
  "description": "%description%",
  "builtin": true,
  "defaultEnabled": false,
  "server": "./server/index.ts",
  "ui": "./ui/dist/index.js",
  "contributes": {
    "tools": true,
    "widgets": ["day"],
    "signals": [
      {
        "type": "sunrise",
        "mode": "subscribe",
        "title": "%signal.sunrise.title%",
        "description": "The sun rose at a place: sent once a day, at local sunrise, for the place in the subscription's config.",
        "config": {
          "type": "object",
          "properties": {
            "place": {"type": "string", "description": "The place's name, as the user would say it"},
            "lat": {"type": "number", "minimum": -90, "maximum": 90, "description": "Latitude in degrees"},
            "lon": {"type": "number", "minimum": -180, "maximum": 180, "description": "Longitude in degrees"},
            "timezone": {"type": "string", "description": "IANA time zone of the place, e.g. Europe/Lisbon"}
          },
          "required": ["lat", "lon", "timezone"],
          "additionalProperties": false
        },
        "data": {
          "type": "object",
          "properties": {
            "place": {"type": "string"},
            "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "sunrise": {"type": "string", "description": "Local time, HH:MM"}
          },
          "required": ["place", "date", "sunrise"]
        },
        "sample": {"place": "Lisbon", "date": "2026-06-21", "sunrise": "06:12"},
        "external": true
      }
    ]
  },
  "integration": {"category": "everyday", "icon": "sunrise", "connect": "none", "summary": "%integration.summary%", "example": "%integration.example%"},
  "permissions": {
    "network": ["api.sunrise-sunset.org"]
  }
}
