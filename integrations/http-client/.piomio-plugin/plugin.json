{
  "id": "http-client",
  "name": "%name%",
  "version": "0.1.0",
  "author": "Piomio",
  "description": "%description%",
  "builtin": true,
  "defaultEnabled": false,
  "server": "./server/index.ts",
  "ui": "./ui/dist/index.js",
  "toolPrefix": "http",
  "contributes": {
    "tools": true,
    "http": true,
    "widgets": ["response"]
  },
  "integration": {"category": "work", "icon": "send", "connect": "none", "summary": "%integration.summary%", "example": "%integration.example%"},
  "permissions": {
    "network": ["*"],
    "vault": ["secret:*"],
    "core": ["settings.get", "ui.emit"],
    "ui": ["route", "layout.sidebar"]
  }
}
