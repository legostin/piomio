# Piomio on a server: copy this file to .env next to docker-compose.yml, uncomment what you need and run
# `docker compose up -d` again. Every variable with its default: README → Environment variables.

# --- The image and its ports (docker-compose.yml reads these) ---

# Which image runs: latest (the last release), main (every change to main) or a version such as 0.3.0.
# PIOMIO_IMAGE_TAG=latest

# Where the chat (8080) and the security console (8081) open. 127.0.0.1: on this server only; reach them from your
# computer through SSH: ssh -N -L 8080:localhost:8080 -L 8081:localhost:8081 you@server, then http://localhost:8080.
# 0.0.0.0: on every address of the server; then set PIOMIO_PUBLIC_URL below. That is plain HTTP: on the open
# internet put HTTPS in front (README → Your own Tailscale or proxy). Docker opens these ports past ufw.
# PIOMIO_BIND=127.0.0.1

# --- Addresses ---

# Where the chat is opened. The hub only answers to its own addresses: without this, http://localhost:8080.
# PIOMIO_PUBLIC_URL=http://203.0.113.10:8080
# The security console (default: the same host, port 8081).
# PIOMIO_CONSOLE_URL=http://203.0.113.10:8081
# More host names the hub answers to, comma-separated.
# PIOMIO_ALLOWED_HOSTS=piomio.example.com
# 1 when a reverse proxy in front (Caddy, nginx) sets X-Forwarded-*.
# PIOMIO_TRUST_PROXY=1

# --- Phones ---

# Addresses phones get in the pairing QR, ahead of the detected ones (publish port 8082 in docker-compose.yml).
# PIOMIO_DEVICE_URLS=https://192.168.1.10:8082
# 0 closes the phones' port: phones then come through the link of access from anywhere.
# PIOMIO_DEVICES=0

# --- Language and time ---

# The hub language, en or ru (by default the first user's browser language).
# PIOMIO_LANG=en
# Time zone for reminders, quiet hours and the digest (default UTC).
# TZ=Europe/Berlin

# --- Security ---

# iptables: the kernel blocks agents' and plugins' direct network access (uncomment cap_add in docker-compose.yml).
# PIOMIO_EGRESS_ENFORCED=iptables
# A file with the vault passphrase, so the vault opens after restarts (a Docker secret, mounted into the container).
# PIOMIO_VAULT_PASSPHRASE_FILE=/run/secrets/piomio_vault

# --- Integrations, access from anywhere, other machines ---

# Your own Google OAuth client (type Desktop app) instead of Piomio's.
# PIOMIO_GOOGLE_CLIENT_ID=
# PIOMIO_GOOGLE_CLIENT_SECRET=
# The hub's node name in your tailnet: the first label of its link.
# PIOMIO_TAILNET_HOSTNAME=piomio
# What this machine is called among the hub's replicas (default: its host name).
# PIOMIO_REPLICA_NAME=vps
# Where machines reach this hub, comma-separated (default: its own address).
# PIOMIO_NODE_URLS=https://piomio.example.com
# The OSRM server for routes on maps.
# PIOMIO_ROUTER_URL=https://routing.openstreetmap.de
