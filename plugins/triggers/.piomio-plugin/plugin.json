{
  "id": "triggers",
  "name": "%name%",
  "version": "0.2.0",
  "description": "%description%",
  "builtin": true,
  "ui": "./ui/dist/index.js",
  "toolPrefix": "trigger",
  "contributes": {
    "settings": {
      "type": "object",
      "properties": {
        "allowPrivateUrls": {
          "type": "boolean",
          "title": "%settings.allowPrivateUrls.title%",
          "description": "%settings.allowPrivateUrls.description%",
          "default": false
        },
        "watchTimeoutSec": {
          "type": "integer",
          "title": "%settings.watchTimeoutSec.title%",
          "default": 30,
          "minimum": 1,
          "maximum": 120
        }
      }
    }
  },
  "integration": {"category": "assistant", "icon": "alarm-clock", "connect": "none", "summary": "%integration.summary%", "example": "%integration.example%"},
  "permissions": {
    "ui": ["route"]
  }
}
