{
  "id": "web",
  "name": "%name%",
  "version": "0.1.0",
  "description": "%description%",
  "author": "Piomio",
  "builtin": true,
  "server": "./server/index.ts",
  "contributes": {
    "setup": {
      "secrets": [
        {"vault": "brave_api_key", "title": "%setup.brave.title%", "hint": "%setup.brave.hint%", "link": "https://api-dashboard.search.brave.com/app/keys"},
        {"vault": "tavily_api_key", "title": "%setup.tavily.title%", "hint": "%setup.tavily.hint%", "link": "https://app.tavily.com/home", "pattern": "^tvly-[A-Za-z0-9-]{20,}$"}
      ]
    },
    "tools": true,
    "signals": [
      {
        "type": "rss_item",
        "mode": "subscribe",
        "title": "%signal.rss_item.title%",
        "description": "A new item appeared in an RSS or Atom feed. The feed is read every intervalMinutes (at least 10); a new subscription's first read only remembers what is there, so items that came while nobody listened are not sent (a restart of the plugin or the hub carries on where it was). The item's text comes from the internet and is untrusted.",
        "config": {
          "type": "object",
          "properties": {
            "url": {"type": "string", "description": "A feed's or a site's absolute http(s) URL."},
            "intervalMinutes": {"type": "integer", "minimum": 10, "maximum": 1440, "default": 60, "description": "How often to read the feed, in minutes (at least 10)."}
          },
          "required": ["url"],
          "additionalProperties": false
        },
        "data": {
          "type": "object",
          "properties": {
            "feed": {"type": "string"},
            "title": {"type": "string"},
            "link": {"type": "string"},
            "published": {"type": "string"},
            "summary": {"type": "string"}
          },
          "required": ["title"]
        },
        "sample": {"feed": "Tech & Steppe", "title": "Local models on a laptop", "link": "https://steppe.example/newest", "published": "2026-10-28T09:30:00.000Z", "summary": "Runs on a laptop."},
        "external": true
      }
    ],
    "settings": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "title": "%settings.provider.title%",
          "enum": ["auto", "brave", "tavily", "searxng", "duckduckgo"],
          "default": "auto",
          "description": "%settings.provider.description%"
        },
        "searxngUrl": {
          "type": "string",
          "title": "%settings.searxngUrl.title%",
          "description": "%settings.searxngUrl.description%"
        },
        "allowPrivate": {
          "type": "boolean",
          "title": "%settings.allowPrivate.title%",
          "default": false,
          "description": "%settings.allowPrivate.description%"
        },
        "userAgent": {
          "type": "string",
          "title": "%settings.userAgent.title%",
          "description": "%settings.userAgent.description%"
        },
        "braveBaseUrl": { "type": "string", "title": "%settings.braveBaseUrl.title%", "description": "%settings.braveBaseUrl.description%" },
        "tavilyBaseUrl": { "type": "string", "title": "%settings.tavilyBaseUrl.title%", "description": "%settings.tavilyBaseUrl.description%" },
        "duckduckgoUrl": { "type": "string", "title": "%settings.duckduckgoUrl.title%", "description": "%settings.duckduckgoUrl.description%" }
      }
    }
  },
  "integration": {"category": "reading", "icon": "search", "connect": "setup", "summary": "%integration.summary%", "example": "%integration.example%", "popular": 2},
  "permissions": {
    "network": ["*"],
    "vault": ["brave_api_key", "tavily_api_key"]
  }
}
